<?xml version="1.0" encoding="utf-8"?>
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:atom="http://www.w3.org/2005/Atom"
  exclude-result-prefixes="atom">

  <xsl:output method="html" encoding="utf-8" indent="yes"
    doctype-system="about:legacy-compat"/>

  <xsl:template name="pretty-date">
    <xsl:param name="iso"/>
    <xsl:variable name="m" select="substring($iso,6,2)"/>
    <xsl:value-of select="number(substring($iso,9,2))"/>
    <xsl:text> </xsl:text>
    <xsl:choose>
      <xsl:when test="$m='01'">January</xsl:when>
      <xsl:when test="$m='02'">February</xsl:when>
      <xsl:when test="$m='03'">March</xsl:when>
      <xsl:when test="$m='04'">April</xsl:when>
      <xsl:when test="$m='05'">May</xsl:when>
      <xsl:when test="$m='06'">June</xsl:when>
      <xsl:when test="$m='07'">July</xsl:when>
      <xsl:when test="$m='08'">August</xsl:when>
      <xsl:when test="$m='09'">September</xsl:when>
      <xsl:when test="$m='10'">October</xsl:when>
      <xsl:when test="$m='11'">November</xsl:when>
      <xsl:otherwise>December</xsl:otherwise>
    </xsl:choose>
    <xsl:text> </xsl:text>
    <xsl:value-of select="substring($iso,1,4)"/>
  </xsl:template>

  <xsl:template match="/">
    <html lang="en">
      <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="robots" content="noindex"/>
        <title><xsl:value-of select="atom:feed/atom:title"/> — Web feed</title>
        <link rel="icon" type="image/svg+xml" href="/assets/img/favicons/favicon.svg"/>
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&amp;family=Newsreader:opsz,wght@6..72,400..700&amp;display=swap"/>
        <style>
          :root {
            color-scheme: light dark;
            --bg: #fcfbf9;
            --surface: #fffefb;
            --rule: #ece7de;
            --text: #2e2c28;
            --muted: #6e6960;
            --heading: #14120f;
            --accent: #8a5e14;
            --accent-soft: rgba(212,160,40,.12);
          }
          @media (prefers-color-scheme: dark) {
            :root {
              --bg: #0f1113;
              --surface: #15171a;
              --rule: #23262b;
              --text: #c4c7cd;
              --muted: #8b8f98;
              --heading: #f1f2f4;
              --accent: #f0b429;
              --accent-soft: rgba(240,180,41,.12);
            }
          }
          * { box-sizing: border-box; }
          body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
          }
          .wrap { max-width: 46rem; margin: 0 auto; padding: 3.5rem 1.25rem 5rem; }
          .eyebrow {
            display: inline-flex; align-items: center; gap: .55rem;
            font-size: .72rem; letter-spacing: .14em; text-transform: uppercase;
            color: var(--muted); margin: 0 0 1rem;
          }
          .eyebrow::before {
            content: ''; width: 6px; height: 6px; border-radius: 50%;
            background: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft);
          }
          h1 {
            font-family: 'Newsreader', Georgia, serif; font-weight: 600;
            font-size: clamp(1.9rem, 1.2rem + 2.2vw, 2.7rem); line-height: 1.15;
            letter-spacing: -.025em; color: var(--heading); margin: 0 0 .6rem;
          }
          .subtitle { color: var(--muted); margin: 0 0 2rem; max-width: 40rem; }
          .note {
            border: 1px solid var(--rule); border-left: 3px solid var(--accent);
            border-radius: 10px; background: var(--surface);
            padding: 1.1rem 1.25rem; margin: 0 0 1.25rem;
          }
          .note p { margin: 0 0 .75rem; }
          .note p:last-child { margin-bottom: 0; }
          .note strong { color: var(--heading); }
          .url {
            display: block; word-break: break-all; margin-top: .25rem;
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: .85rem; color: var(--accent);
            background: var(--accent-soft); border-radius: 6px; padding: .5rem .7rem;
          }
          .actions { display: flex; flex-wrap: wrap; gap: .6rem; margin: 0 0 3rem; }
          .btn {
            display: inline-flex; align-items: center; gap: .4rem;
            padding: .5rem 1rem; border-radius: 999px;
            border: 1px solid var(--rule); background: var(--surface);
            color: var(--text); text-decoration: none; font-size: .87rem;
            transition: border-color .2s ease, transform .2s ease;
          }
          .btn:hover { border-color: var(--accent); transform: translateY(-1px); }
          .btn--primary { background: var(--heading); border-color: var(--heading); color: var(--bg); }
          .label {
            display: flex; align-items: center; gap: 1rem;
            font-size: .72rem; letter-spacing: .16em; text-transform: uppercase;
            color: var(--muted); margin: 0 0 1.25rem;
          }
          .label::after { content: ''; flex: 1; height: 1px; background: var(--rule); }
          .entry {
            border: 1px solid var(--rule); border-radius: 12px;
            background: var(--surface); padding: 1.35rem 1.4rem; margin-bottom: 1rem;
            transition: border-color .25s ease, transform .25s ease;
          }
          .entry:hover { border-color: var(--accent); transform: translateY(-2px); }
          .entry h2 {
            font-family: 'Newsreader', Georgia, serif; font-weight: 600;
            font-size: 1.3rem; line-height: 1.3; letter-spacing: -.02em;
            margin: 0 0 .4rem;
          }
          .entry h2 a { color: var(--heading); text-decoration: none; }
          .entry h2 a:hover { color: var(--accent); }
          .meta { font-size: .78rem; color: var(--muted); margin: 0 0 .7rem; }
          .summary { font-size: .95rem; color: var(--muted); margin: 0; }
          footer {
            margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--rule);
            font-size: .82rem; color: var(--muted);
          }
          footer a { color: var(--accent); }
        </style>
      </head>
      <body>
        <div class="wrap">
          <p class="eyebrow">Atom web feed</p>
          <h1><xsl:value-of select="atom:feed/atom:title"/></h1>
          <p class="subtitle"><xsl:value-of select="atom:feed/atom:subtitle"/></p>

          <div class="note">
            <p>
              <strong>This page is a web feed.</strong> It's meant for a feed reader —
              an app that checks sites like this one for you and collects new posts in
              one place, with no algorithm and no account.
            </p>
            <p>
              Paste this address into your reader to subscribe:
              <code class="url"><xsl:value-of select="atom:feed/atom:link[@rel='self']/@href"/></code>
            </p>
          </div>

          <div class="actions">
            <a class="btn btn--primary" href="/">Back to the site</a>
            <a class="btn" href="/archives/">Archive</a>
            <a class="btn" href="/about/">About</a>
          </div>

          <p class="label">
            <xsl:text>Latest </xsl:text>
            <xsl:value-of select="count(atom:feed/atom:entry)"/>
            <xsl:text> posts</xsl:text>
          </p>

          <xsl:for-each select="atom:feed/atom:entry">
            <article class="entry">
              <h2>
                <a href="{atom:link[@rel='alternate']/@href}">
                  <xsl:value-of select="atom:title"/>
                </a>
              </h2>
              <p class="meta">
                <xsl:call-template name="pretty-date">
                  <xsl:with-param name="iso" select="atom:published"/>
                </xsl:call-template>
                <xsl:for-each select="atom:category">
                  <xsl:text> · </xsl:text>
                  <xsl:value-of select="@term"/>
                </xsl:for-each>
              </p>
              <p class="summary"><xsl:value-of select="atom:summary"/></p>
            </article>
          </xsl:for-each>

          <footer>
            <xsl:value-of select="atom:feed/atom:rights"/>
            <xsl:text> · </xsl:text>
            <a href="/">shivamlko9832.github.io</a>
          </footer>
        </div>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
